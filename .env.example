# Copy to .env and adjust. .env is git-ignored; CI reads these from GitHub environment secrets.
# The values below are the publicly documented demo credentials of the test targets.

# Which config/environments/<name>.yaml to load (overridden by --env)
TEST_ENV=dev

# UI target (https://www.saucedemo.com)
UI_USERNAME=standard_user
UI_PASSWORD=secret_sauce

# API target (https://dummyjson.com)
API_USERNAME=emilys
API_PASSWORD=emilyspass

# Optional: override base URLs from the environment file
# UI_BASE_URL=
# API_BASE_URL=
